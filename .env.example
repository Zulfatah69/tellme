# =============================================================================
# TellMe — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in real values.
# The .env file must NEVER be committed to version control.
# =============================================================================

# Database
DB_URL=jdbc:mysql://localhost:3306/tellme_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=TellMe Platform <your-email@gmail.com>

# Email Routing
MAIL_ROUTING_ORGANISASI=student-org@example.com
MAIL_ROUTING_AKADEMIK=academic-office@example.com

# Upload
UPLOAD_DIR=uploads
UPLOAD_MAX_FILES=5
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=25MB

# Server
SERVER_PORT=8081
