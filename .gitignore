# =============================================================================
# TellMe — .gitignore
# =============================================================================

# --- Build Output ---
target/
*.jar
*.war
*.class

# --- Maven Wrapper ---
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- Secrets & Local Config ---
application-local.properties
.env
*.env
!.env.example

# --- Uploads (runtime generated) ---
uploads/

# --- IDE: IntelliJ IDEA ---
.idea/
*.iws
*.iml
*.ipr
out/

# --- IDE: Eclipse / STS ---
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# --- IDE: NetBeans ---
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# --- IDE: VS Code ---
.vscode/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Packaging ---
*.zip
*.tar.gz

# --- Scripts (dev convenience only) ---
start-*.bat
start-*.sh

# --- Presentation / Assignment artifacts ---
*.txt
!README.txt
